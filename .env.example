# Copy to .env to override defaults:  cp .env.example .env
# Docker Compose reads .env automatically. NEVER commit a real .env.

# --- General ------------------------------------------------------------------
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000
# comma-separated list
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (used by docker compose to build DATABASE_URL) ------------------
POSTGRES_USER=eve
# change outside local development
POSTGRES_PASSWORD=eve
POSTGRES_DB=eve
# For running the API/tests outside Docker (compose builds its own from the values above):
# DATABASE_URL=postgresql+psycopg://eve:eve@localhost:5432/eve
# REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------------
# REQUIRED to be a strong random value (>=32 chars) when ENVIRONMENT=production.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Bookings -----------------------------------------------------------------
# earliest appointment = now + this
BOOKING_MIN_LEAD_MINUTES=60
BOOKING_MAX_DAYS_AHEAD=90

# --- Simulated payments -------------------------------------------------------
# default outcome: success | failure | pending
PAYMENT_SIMULATION_MODE=success
# lets clients send simulate_outcome. MUST be false in production
PAYMENT_ALLOW_SIMULATION_OVERRIDE=true
# PENDING payments older than this are failed by the cleanup task
PAYMENT_STALE_AFTER_MINUTES=15

# --- Webhooks -----------------------------------------------------------------
WEBHOOK_SECRET=dev-webhook-secret
# true => require X-Webhook-Signature: sha256=<HMAC of raw body>
WEBHOOK_SIGNATURE_REQUIRED=false
WEBHOOK_MAX_RETRIES=5
# must have WEBHOOK_MAX_RETRIES entries
WEBHOOK_RETRY_BACKOFF_SECONDS=1,5,15,30,60

# --- Cache --------------------------------------------------------------------
CACHE_TTL_SECONDS=60

# --- Rate limiting (requests per window, per client IP) -------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# signup + login
RATE_LIMIT_AUTH_PER_WINDOW=10
RATE_LIMIT_PAYMENT_PER_WINDOW=20
RATE_LIMIT_WEBHOOK_PER_WINDOW=120

# --- Startup (docker) ---------------------------------------------------------
# load demo centres/tests (idempotent)
SEED_ON_STARTUP=true
